<nav class="navbar navbar-expand-lg bg-body border-bottom">
  <div class="container">
    <a class="navbar-brand fw-semibold" href="#hero">
      {{ navigation.brand or meta.title }}
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#json2uiNav"
      aria-controls="json2uiNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="json2uiNav">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        {% for link in navigation.links %}
          <li class="nav-item">
            <a
              class="nav-link"
              href="{{ link.href }}"
              {% if link.external %}target="_blank" rel="noreferrer noopener"{% endif %}
            >
              {{ link.label }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</nav>
