{% from "macros/render.html.j2" import render_section %}

<section id="{{ section.id or '' }}" class="py-4">
  <ul class="nav nav-tabs mb-3" id="tabs-{{ section._uid }}" role="tablist">
    {% for tab in section.tabs %}
    <li class="nav-item" role="presentation">
      <button class="nav-link {{ 'active' if loop.first }}" id="tab-{{ section._uid }}-{{ loop.index0 }}-btn" data-bs-toggle="tab" data-bs-target="#tab-{{ section._uid }}-{{ loop.index0 }}" type="button" role="tab" aria-controls="tab-{{ section._uid }}-{{ loop.index0 }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ tab.label }}</button>
    </li>
    {% endfor %}
  </ul>
  <div class="tab-content" id="tabs-{{ section._uid }}-content">
    {% for tab in section.tabs %}
    <div class="tab-pane fade {{ 'show active' if loop.first }}" id="tab-{{ section._uid }}-{{ loop.index0 }}" role="tabpanel" aria-labelledby="tab-{{ section._uid }}-{{ loop.index0 }}-btn" tabindex="0">
      {% for child in tab.sections %}
        {{ render_section(child) }}
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</section>
